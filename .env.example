# PHL5 Hourly Tracker — Environment Config
# Copy this to .env and fill in your values.
# Never commit .env to git.

# ── DRAX (browser session cookie) ─────────────────────────────────────────────
# 1. Open https://drax.walmart.com in Chrome
# 2. F12 → Network → refresh page → click any request → Headers → Cookie
# 3. Paste the full Cookie header value below
DRAX_COOKIE=

# Optional override (defaults to https://drax.walmart.com)
# DRAX_BASE_URL=https://drax.walmart.com

# ── Gscope (Distributor Capacity 2.0) ─────────────────────────────────────────
# Option A — gateway_token (preferred, lasts longer)
# 1. Open https://gscope.walmart.com in Chrome → F12 → Application → Cookies
# 2. Copy the value of gateway_token
GSCOPE_TOKEN=

# Option B — full Cookie header fallback (same steps as DRAX above)
GSCOPE_COOKIE=

# PHL5 Distributor node ID and pool IDs — these rarely change
GSCOPE_DISTRIBUTOR_ID=31341
GSCOPE_POOL_1P=1
GSCOPE_POOL_3P=4
GSCOPE_POOL_SAMS=27

# Optional override (defaults to https://gscope.walmart.com)
# GSCOPE_BASE_URL=https://gscope.walmart.com

# ── Endgame uses MSAL device-code auth — no config needed here ────────────────
# First run will prompt you to log in once; token is cached in
# .token_cache_endgame.json automatically.
